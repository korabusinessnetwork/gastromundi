{
  "autoCompactEnabled": true,
  "autoCompactWindow": 160000,
  "permissions": {
    "allow": [
      "Bash(npx vite *)",
      "Bash(grep -v \"//.*fontSize\")",
      "Bash(git commit -m ' *)",
      "Bash(Get-Content \"c:\\\\Users\\\\Bonas\\\\Documents\\\\Gastromundi by Kora\\\\gastromundi\\\\.env.local\")",
      "Bash(Select-String \"SUPABASE_URL\")"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-git-branch.mjs\""
          }
        ]
      }
    ]
  }
}
