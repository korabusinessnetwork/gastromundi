# ─────────────────────────────────────────────────────────────────────
# Configuracao do bot importador de cardapio. Copie este arquivo para
# `.env` (mesma pasta) e preencha. O `.env` NUNCA vai pro git (.gitignore).
#
# SEGURANCA: SUPABASE_URL e SUPABASE_ANON_KEY sao PUBLICOS (a mesma chave
# anon ja embarcada no app web) — nao sao segredo. Ja BOT_EMAIL/BOT_PASSWORD
# sao o login de um usuario real do seu estabelecimento: o bot escreve
# exatamente com as permissoes desse usuario (RLS + tenant do JWT). Use de
# preferencia um usuario dedicado, so pra importacao. Nunca compartilhe o .env.
# ─────────────────────────────────────────────────────────────────────

# Projeto Supabase (mesmos valores do app web — .env.local do projeto):
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica

# Login do usuario com que o bot vai gravar (tenant vem do JWT dele):
BOT_EMAIL=usuario@seurestaurante.com
BOT_PASSWORD=troque-aqui

# Pasta vigiada. Solte as planilhas .csv/.xlsx aqui; o bot importa e move
# pra "processados/" (ou "erros/"). Padrao: ./entrada
WATCH_DIR=./entrada
