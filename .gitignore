node_modules/
dist/
.env
.env.local
.env.*.local
.env.migration

# Config pessoal do Obsidian (vault apontado para memory/ ou raiz)
.obsidian/

# Cópia pronta do KoraPonte.exe para acesso rápido (gerada com
# `npm run build:exe` dentro de ponte/). São 56 MB de binário — o LEIAME
# da pasta vai para o repositório, o executável não.
executavel/*.exe

# Worktrees das frentes paralelas (sessões de agente em cópia isolada do
# repositório). São criadas e removidas pelo Claude Code durante a execução, e
# cada uma é uma cópia inteira do projeto: nunca entram no histórico.
.claude/worktrees/
